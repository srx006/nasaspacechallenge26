{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spacedogs.example/istmosar/contracts/v1/error.schema.json",
  "title": "ISTMOSAR API Error v1",
  "description": "Error body shared by every endpoint. An error never carries scientific result fields: unavailable results are reported, not simulated.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "error"
  ],
  "properties": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "http_status"
      ],
      "properties": {
        "code": {
          "enum": [
            "RESOURCE_NOT_FOUND",
            "INVALID_PARAMETER",
            "INVALID_SCENE_PAIR",
            "INCOMPATIBLE_OBSERVATIONS",
            "UNVERIFIED_DATA",
            "LAYER_NOT_GENERATED",
            "SCIENTIFIC_PROCESSING_UNAVAILABLE",
            "INTERNAL_PROCESSING_FAILURE"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 3,
          "maxLength": 300,
          "pattern": "^(?!.*(Traceback|[A-Za-z]:\\\\|/home/|/mnt/|/Users/)).+$",
          "description": "User-safe text. No stack traces, file paths, credentials or fabricated science."
        },
        "http_status": {
          "type": "integer",
          "minimum": 400,
          "maximum": 599
        },
        "detail": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "resource_type": {
              "enum": [
                "STUDY_AREA",
                "SCENE",
                "ANALYSIS",
                "LAYER"
              ]
            },
            "resource_id": {
              "type": "string",
              "maxLength": 120
            },
            "parameter": {
              "type": "string",
              "maxLength": 60
            },
            "reason_codes": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$"
              }
            },
            "analysis_id": {
              "$ref": "common.schema.json#/$defs/Id"
            },
            "compatibility_decision": {
              "enum": [
                "PENDING",
                "GO",
                "NO_GO",
                "INSUFFICIENT_EVIDENCE"
              ]
            },
            "lifecycle_status": {
              "enum": [
                "NOT_STARTED",
                "PLANNED",
                "PROCESSING",
                "COMPLETED",
                "FAILED"
              ]
            },
            "requested_role": {
              "enum": [
                "SCENE_BACKSCATTER",
                "BEFORE",
                "AFTER",
                "CHANGE",
                "CHANGE_MASK",
                "VALID_MASK",
                "CONTEXT"
              ]
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "code": {
                "const": "RESOURCE_NOT_FOUND"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "http_status": {
                "const": 404
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "INVALID_PARAMETER"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "http_status": {
                "const": 422
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "INVALID_SCENE_PAIR"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "http_status": {
                "const": 422
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "INCOMPATIBLE_OBSERVATIONS"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "http_status": {
                "const": 409
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "UNVERIFIED_DATA"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "http_status": {
                "const": 409
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "LAYER_NOT_GENERATED"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "http_status": {
                "const": 409
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "SCIENTIFIC_PROCESSING_UNAVAILABLE"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "http_status": {
                "const": 503
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "INTERNAL_PROCESSING_FAILURE"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "http_status": {
                "const": 500
              }
            }
          }
        }
      ]
    }
  }
}
