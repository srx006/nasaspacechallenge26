{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spacedogs.example/istmosar/contracts/v1/study-area.schema.json",
  "title": "ISTMOSAR Study Area v1",
  "description": "A geographic area of interest. CANDIDATE areas are research proposals, not approved scientific cases.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "data_category",
    "name",
    "country",
    "region",
    "bbox_lonlat",
    "crs",
    "geometry",
    "selection_status",
    "scientific_purpose",
    "evidence_refs"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/Id"
    },
    "data_category": {
      "enum": [
        "PROPOSED_STRUCTURE",
        "SIMULATED_DATA"
      ],
      "description": "Study areas are team-defined, never VERIFIED_METADATA."
    },
    "name": {
      "$ref": "common.schema.json#/$defs/NonEmptyText"
    },
    "country": {
      "type": "string",
      "pattern": "^[A-Z]{2}$",
      "description": "ISO 3166-1 alpha-2 (XX only for SIMULATED_DATA)."
    },
    "region": {
      "$ref": "common.schema.json#/$defs/NonEmptyText"
    },
    "bbox_lonlat": {
      "$ref": "common.schema.json#/$defs/BBoxLonLat"
    },
    "crs": {
      "const": "EPSG:4326",
      "description": "All study-area coordinates are WGS84 longitude/latitude degrees."
    },
    "geometry": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/PolygonLonLat"
        },
        {
          "type": "null"
        }
      ]
    },
    "selection_status": {
      "enum": [
        "CANDIDATE",
        "APPROVED",
        "REJECTED"
      ]
    },
    "scientific_purpose": {
      "$ref": "common.schema.json#/$defs/NonEmptyText"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "ref",
          "note"
        ],
        "properties": {
          "kind": {
            "enum": [
              "EVIDENCE_INDEX_ID",
              "REPOSITORY_PATH",
              "URL"
            ]
          },
          "ref": {
            "type": "string",
            "minLength": 3
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "selection_status": {
            "const": "APPROVED"
          }
        },
        "required": [
          "selection_status"
        ]
      },
      "then": {
        "properties": {
          "evidence_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "data_category": {
            "const": "SIMULATED_DATA"
          }
        },
        "required": [
          "data_category"
        ]
      },
      "then": {
        "properties": {
          "country": {
            "const": "XX"
          }
        }
      },
      "else": {
        "properties": {
          "country": {
            "not": {
              "const": "XX"
            }
          }
        }
      }
    }
  ]
}
