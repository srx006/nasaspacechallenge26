{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spacedogs.example/istmosar/contracts/v1/provenance.schema.json",
  "title": "ISTMOSAR Scientific Provenance v1",
  "description": "How a result (or the decision not to compute one) can be reproduced. Contains no credentials; parameters and software are closed sets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "status",
    "sources",
    "processing",
    "outputs",
    "quality_checks",
    "review"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/Id"
    },
    "status": {
      "enum": [
        "NOT_STARTED",
        "PLANNED",
        "EXECUTED_UNVERIFIED",
        "VERIFIED",
        "FAILED"
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scene_id",
          "granule_id",
          "cmr_concept_id",
          "catalog_url",
          "collection",
          "product_maturity",
          "retrieval",
          "dataset_paths_inspected",
          "catalog_checksum",
          "local_sha256"
        ],
        "properties": {
          "scene_id": {
            "$ref": "common.schema.json#/$defs/Id"
          },
          "granule_id": {
            "type": "string",
            "minLength": 3
          },
          "cmr_concept_id": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/CmrGranuleConceptId"
              },
              {
                "type": "null"
              }
            ]
          },
          "catalog_url": {
            "$ref": "common.schema.json#/$defs/HttpsUrl"
          },
          "collection": {
            "type": "string",
            "minLength": 3
          },
          "product_maturity": {
            "enum": [
              "BETA",
              "PROVISIONAL",
              "VALIDATED",
              "NOT_APPLICABLE"
            ]
          },
          "retrieval": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "method",
              "retrieved_at_utc"
            ],
            "properties": {
              "status": {
                "enum": [
                  "NOT_RETRIEVED",
                  "RETRIEVED"
                ]
              },
              "method": {
                "enum": [
                  "ASF_VERTEX",
                  "EARTHDATA_SEARCH",
                  "CMR_API",
                  "HARMONY",
                  "EARTHACCESS",
                  "MANUAL_BROWSER_DOWNLOAD",
                  "OTHER",
                  null
                ]
              },
              "retrieved_at_utc": {
                "anyOf": [
                  {
                    "$ref": "common.schema.json#/$defs/UtcTimestamp"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "NOT_RETRIEVED"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "properties": {
                    "method": {
                      "const": null
                    },
                    "retrieved_at_utc": {
                      "type": "null"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "RETRIEVED"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "properties": {
                    "method": {
                      "type": "string"
                    },
                    "retrieved_at_utc": {
                      "type": "string"
                    }
                  }
                }
              }
            ]
          },
          "dataset_paths_inspected": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^/science/LSAR/GCOV/grids/frequency[AB]/[A-Za-z]+$"
            },
            "description": "HDF5 dataset paths actually opened and inspected. Empty means none; nominal paths from file names do not belong here."
          },
          "catalog_checksum": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "algorithm",
                  "value"
                ],
                "properties": {
                  "algorithm": {
                    "enum": [
                      "MD5",
                      "SHA-256"
                    ]
                  },
                  "value": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{32}([a-f0-9]{32})?$"
                  }
                },
                "description": "Checksum as declared by the catalog (MD5) or computed locally (SHA-256)."
              },
              {
                "type": "null"
              }
            ]
          },
          "local_sha256": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/Sha256"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "processing": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "selected_channel",
            "measurement_convention",
            "source_crs",
            "destination_crs",
            "resampling_method",
            "grid_alignment",
            "masking_rules",
            "parameters",
            "software",
            "started_at_utc",
            "completed_at_utc"
          ],
          "properties": {
            "selected_channel": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "covariance_term",
                "frequency_band"
              ],
              "properties": {
                "covariance_term": {
                  "$ref": "common.schema.json#/$defs/DiagonalCovarianceTerm"
                },
                "frequency_band": {
                  "$ref": "common.schema.json#/$defs/FrequencyBand"
                }
              }
            },
            "measurement_convention": {
              "enum": [
                "GAMMA0",
                "SIGMA0"
              ]
            },
            "source_crs": {
              "$ref": "common.schema.json#/$defs/EpsgCode"
            },
            "destination_crs": {
              "$ref": "common.schema.json#/$defs/EpsgCode"
            },
            "resampling_method": {
              "enum": [
                "NEAREST",
                "BILINEAR",
                "CUBIC",
                "AVERAGE",
                "NOT_APPLICABLE"
              ]
            },
            "grid_alignment": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "reference_scene_id",
                "target_pixel_size_m",
                "alignment_verified"
              ],
              "properties": {
                "reference_scene_id": {
                  "$ref": "common.schema.json#/$defs/Id"
                },
                "target_pixel_size_m": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "alignment_verified": {
                  "type": "boolean"
                }
              }
            },
            "masking_rules": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "common.schema.json#/$defs/NonEmptyText"
              }
            },
            "parameters": {
              "$ref": "common.schema.json#/$defs/ProcessingParameters"
            },
            "software": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {
                "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
              },
              "additionalProperties": {
                "type": "string",
                "pattern": "^[0-9A-Za-z.+_-]{1,40}$"
              },
              "description": "Library name -> version string. Values are restricted so credentials cannot be stored here."
            },
            "started_at_utc": {
              "$ref": "common.schema.json#/$defs/UtcTimestamp"
            },
            "completed_at_utc": {
              "$ref": "common.schema.json#/$defs/UtcTimestamp"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "kind",
          "sha256"
        ],
        "properties": {
          "artifact_id": {
            "$ref": "common.schema.json#/$defs/Id"
          },
          "kind": {
            "enum": [
              "BEFORE_RASTER",
              "AFTER_RASTER",
              "DELTA_DB_RASTER",
              "CHANGE_MASK",
              "VALID_MASK",
              "STATISTICS",
              "OTHER"
            ]
          },
          "sha256": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/Sha256"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "quality_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "status",
          "description",
          "evidence_ref"
        ],
        "properties": {
          "check_id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
          },
          "status": {
            "enum": [
              "PENDING",
              "PASS",
              "FAIL",
              "NOT_APPLICABLE"
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "review": {
      "$ref": "common.schema.json#/$defs/ReviewRecord"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "NOT_STARTED",
              "PLANNED"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "processing": {
            "type": "null"
          },
          "outputs": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "EXECUTED_UNVERIFIED",
              "VERIFIED"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "processing": {
            "type": "object"
          },
          "outputs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "VERIFIED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "review": {
            "properties": {
              "status": {
                "const": "APPROVED"
              }
            }
          }
        }
      }
    }
  ]
}
